# ==============================================================================
# Victus AI Assistant - Environment Variables Template
# Copy this file to '.env' and fill in your private API keys.
# NEVER commit the '.env' file to version control (Git)!
# ==============================================================================

# OpenWeatherMap API Key (Free from https://openweathermap.org/api)
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# Default City for Weather Queries
DEFAULT_CITY=Kolkata

# LM Studio Configuration (Optional - Defaults to local port 1234)
LMSTUDIO_URL=http://127.0.0.1:1234

# Ollama Configuration (Optional - Defaults to local port 11434)
OLLAMA_URL=http://127.0.0.1:11434

# Phone Control Server Port (Default: 5000)
PHONE_SERVER_PORT=5000
